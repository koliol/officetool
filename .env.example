# 复制本文件为 .env 后按实际环境修改（.env 不要提交到 Git）

# 对外的 HTTP 端口
HOST_PORT=8080

# 容器时区。影响文档日期命名（yyyyMMdd），务必设为本地时区
TZ=Asia/Shanghai

# ── 客户端视角 ─────────────────────────────────────────────
# 用户在网络位置 / 资源管理器里访问 NAS 用的主机名或 IP
NAS_HOST=NAS
# 共享文件夹名（不是卷路径）
SHARE_NAME=OfficeDocs

# ── 服务端视角 ─────────────────────────────────────────────
# 群晖上该共享文件夹的真实路径，通常是 /volume1/<共享文件夹名>
# ⚠️ 这个目录必须**先存在**（在 DSM 里建好共享文件夹即可），
#    否则 compose 会报 "Bind mount failed: ... does not exist"
SHARE_PATH=/volume1/OfficeDocs

# 日志不需要配置：已改用 Docker 命名卷，自动创建。
# 查看日志： docker compose logs -f officetool

# ── 运行权限（群晖上大概率需要填）──────────────────────────
# 容器默认以镜像内置用户 app（1654:1654）运行。
# 群晖共享文件夹走 Synology ACL，该 uid 没有 ACL 身份，会报「模板根 不可用」。
#
# 填法：SSH 执行 `id 你的用户名`，例如输出
#   uid=1026(koliol) gid=100(users) groups=100(users),101(administrators)
# 则填：
PUID=1026
PGID=100
# 附加组照抄 groups 列表（去掉主组也行，留着不影响）：
# 这一步很关键 —— 群晖的 ACL 常常只授给某个组（如 administrators），
# 你的权限是通过附加组来的，不填会报 Permission denied。
SUP_GIDS=100,101

# 若填了仍不可写，再试 root（能绕过 ACL，但生成的文件属主是 root）：
# PUID=0
# PGID=0

# ── 鉴权 ───────────────────────────────────────────────────
# 总开关。true = 要求登录并按下述分组授权；false = 完全放行（内网可信形态）。
#
# ⚠️ 首次以 true 启动时会自动创建一个本地超管，初始密码**只打印一次**，
#    在容器日志里，形如：
#      已创建本地超级管理员 admin，初始密码：xxxxxxxxxxxxxxxx
#    用 `docker compose logs officetool | grep 初始密码` 取出来，登录后立即改密。
#    漏看了也不要紧：删掉状态卷重来即可（会丢项目/模板索引，但文件还在 /data）。
AUTH_ENABLED=true

# 超管登录名（首次启动时创建；后续改这个值不会再创建新账号）
AUTH_BOOTSTRAP_ADMIN=admin

# AD 域名，如 contoso.com。**只有填了这一项才会去 LDAP 取所属组**。
#
# 为什么必须填：Linux 上的 Kerberos 认证不返回任何组信息，
# 不配 LDAP 的话域用户能登录进来但拿不到任何授权（等于什么都看不到）。
# 未接入域的部署留空即可，只用本地账号。
AUTH_DOMAIN=

# 查询 LDAP 用的机器账号（域管理员预先创建）。留空则匿名绑定，
# 多数 AD 默认禁止匿名查询，所以生产上基本都要填。
AUTH_LDAP_USER=
AUTH_LDAP_PASSWORD=

# 是否递归解析嵌套组。域很大时建议 true（默认）改 false，
# 否则每次登录都要展开整棵组树，会很慢。
AUTH_IGNORE_NESTED_GROUPS=true

# 浏览器免登录（Windows 集成认证）所需的登录态有效期。
AUTH_COOKIE_HOURS=8

# 权限缓存分钟数。改完授权后缓存会立刻失效，这个值只影响
# 「在 AD 里被改组」这类外部变更的生效延迟。
AUTH_ACL_CACHE_MINUTES=5

# ── 国内网络加速（强烈建议）────────────────────────────────
# npm 官方源在国内 NAS 上极易超时，症状：npm error Exit handler never called!
NPM_REGISTRY=https://registry.npmmirror.com
# 注：构建已不再依赖 apt / Debian 源（运行时镜像自带 tzdata 与 bash），
#     因此不需要配置 DEBIAN_MIRROR。
