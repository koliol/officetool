# 复制本文件为 .env 后按实际环境修改（.env 不要提交到 Git）

# 对外的 HTTP 端口
HOST_PORT=8080

# 容器时区。影响文档日期命名（yyyyMMdd），务必设为本地时区
TZ=Asia/Shanghai

# ── 客户端视角 ─────────────────────────────────────────────
# 用户在网络位置 / 资源管理器里访问 NAS 用的主机名或 IP
NAS_HOST=NAS
# 共享文件夹名（不是卷路径）
SHARE_NAME=OfficeDocs

# ── 服务端视角 ─────────────────────────────────────────────
# 群晖上该共享文件夹的真实路径，通常是 /volume1/<共享文件夹名>
# ⚠️ 这个目录必须**先存在**（在 DSM 里建好共享文件夹即可），
#    否则 compose 会报 "Bind mount failed: ... does not exist"
SHARE_PATH=/volume1/OfficeDocs

# 日志不需要配置：已改用 Docker 命名卷，自动创建。
# 查看日志： docker compose logs -f officetool

# ── 运行权限（群晖上大概率需要填）──────────────────────────
# 容器默认以镜像内置用户 app（1654:1654）运行。
# 群晖共享文件夹走 Synology ACL，该 uid 没有 ACL 身份，会报「模板根 不可用」。
#
# 填法：SSH 执行 `id 你的用户名`，例如输出
#   uid=1026(koliol) gid=100(users) groups=100(users),101(administrators)
# 则填：
PUID=1026
PGID=100
# 附加组照抄 groups 列表（去掉主组也行，留着不影响）：
# 这一步很关键 —— 群晖的 ACL 常常只授给某个组（如 administrators），
# 你的权限是通过附加组来的，不填会报 Permission denied。
SUP_GIDS=100,101

# 若填了仍不可写，再试 root（能绕过 ACL，但生成的文件属主是 root）：
# PUID=0
# PGID=0

# ── 国内网络加速（强烈建议）────────────────────────────────
# npm 官方源在国内 NAS 上极易超时，症状：npm error Exit handler never called!
NPM_REGISTRY=https://registry.npmmirror.com
# 注：构建已不再依赖 apt / Debian 源（运行时镜像自带 tzdata 与 bash），
#     因此不需要配置 DEBIAN_MIRROR。
