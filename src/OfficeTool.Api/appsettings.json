{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=officetool.db"
  },
  "Storage": {
    "Mode": "Local",
    "TemplatesRoot": "./officetool-share/Templates",
    "DataRoot": "./officetool-share/Data",
    "AttachmentsRoot": "",
    "ClientTemplatesRoot": "",
    "ClientDataRoot": "",
    "ClientAttachmentsRoot": "",
    "RulesRoot": "",
    "ClientRulesRoot": "",
    "Domain": "",
    "UserName": "",
    "EncryptedPassword": ""
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Upload": {
    "AllowedExtensions": [ ".docx", ".xlsx", ".pptx", ".docm", ".xlsm", ".pptm" ],
    "AttachmentExtensions": [],
    "RuleExtensions": [],
    "MaxSizeMB": 100
  },
  "DesktopPlugin": {
    "DownloadUrl": "",
    "Protocol": "officetool"
  },
  "AllowedHosts": "*"
}
