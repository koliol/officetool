{
  "_comment": [
    "群晖 NAS / Docker 部署配置。",
    "容器启动时设置 ASPNETCORE_ENVIRONMENT=Production 即会加载本文件叠加覆盖 appsettings.json。",
    "服务端路径 = 容器内路径；客户端路径 = 用户在资源管理器/桌面插件里用的路径。",
    "两者指向同一份数据，只是视角不同（见 docs/deployment-synology.md）。"
  ],
  "ConnectionStrings": {
    "Default": "Data Source=/app/state/officetool.db"
  },
  "Storage": {
    "Mode": "Local",
    "TemplatesRoot": "/data/Templates",
    "DataRoot": "/data/Data",
    "AttachmentsRoot": "/data/Attachments",
    "ClientTemplatesRoot": "\\\\NAS\\OfficeDocs\\Templates",
    "ClientDataRoot": "\\\\NAS\\OfficeDocs\\Data",
    "ClientAttachmentsRoot": "\\\\NAS\\OfficeDocs\\Attachments",
    "RulesRoot": "/data/ExtractionRules",
    "ClientRulesRoot": "\\\\NAS\\OfficeDocs\\ExtractionRules",
    "Domain": "",
    "UserName": "",
    "EncryptedPassword": ""
  },
  "DataProtection": {
    "KeysPath": "/app/keys"
  },
  "Upload": {
    "AllowedExtensions": [ ".docx", ".xlsx", ".pptx", ".docm", ".xlsm", ".pptm" ],
    "AttachmentExtensions": [],
    "RuleExtensions": [],
    "MaxSizeMB": 100
  },
  "DesktopPlugin": {
    "DownloadUrl": "\\\\NAS\\OfficeDocs\\plugin\\OfficeToolPlugin.exe",
    "Protocol": "officetool"
  },
  "AllowedHosts": "*"
}
